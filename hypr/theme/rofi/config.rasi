/* ~/.config/hypr/theme/rofi/config.rasi - Tokyo Night, square corners, matches the bar */
configuration {
    modi: "drun";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    /* Typing "len": names that START with "len" come first, looser guesses (Blender ...) below. */
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    scroll-method: 1;                 /* continuous scrolling instead of jumping a whole page */
    /* Not in the list? Type the command and press Enter (or Ctrl+Enter to force it).
       run-cmd opens terminal apps (btop, impala, nvim ...) inside kitty and everything else directly. */
    run-command: "run-cmd {cmd}";
    run-shell-command: "run-cmd {cmd}";
    terminal: "kitty";
    /* rofi-wayland reports the wheel direction the other way round from native apps: swap it.
       If scrolling feels reversed for you, delete these two lines. */
    ml-row-up: "ScrollDown";
    ml-row-down: "ScrollUp";
}

* {
    bg:      #1a1b26;
    bg-alt:  #1f2335;
    fg:      #a9b1d6;
    muted:   #444b6a;
    dim:     #787c99;
    bright:  #c0caf5;
    accent:  #0db9d7;
    urgent:  #f7768e;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 560px;
    background-color: @bg;
    border: 1px;
    border-color: @muted;
    border-radius: 0;
}

mainbox {
    padding: 12px;
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-color: @muted;
    padding: 10px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }

entry {
    text-color: @bright;
    placeholder: "Search...";
    placeholder-color: @dim;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 8px 10px;
    spacing: 10px;
}

element normal.normal   { background-color: transparent; text-color: @fg; }
element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @bg-alt; text-color: @accent; }
element normal.urgent, element selected.urgent { text-color: @urgent; }

element-icon { size: 24px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }

/* Error / message dialogs (for example a mistyped command) must be easy to read. */
error-message {
    background-color: @bg-alt;
    border: 2px;
    border-color: @urgent;
    padding: 16px;
}
error-message textbox {
    background-color: transparent;
    text-color: @bright;
    font: "JetBrainsMono Nerd Font Bold 13";
    markup: false;
}
message {
    background-color: @bg-alt;
    border: 0 0 1px 0;
    border-color: @muted;
    padding: 10px 14px;
}
message textbox {
    background-color: transparent;
    text-color: @bright;
}
