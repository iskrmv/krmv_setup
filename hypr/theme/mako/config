# ~/.config/hypr/theme/mako/config - Tokyo Night, square corners, matches the bar
# UNUSED fallback: notifications are handled by Quickshell now. To go back to mako,
# start it in conf/autostart.lua and remove Notifications from shell.qml.
font=JetBrainsMono Nerd Font 11
background-color=#1a1b26
text-color=#a9b1d6
border-color=#444b6a
progress-color=over #0db9d7
border-size=1
border-radius=0
padding=12
margin=10
width=360
anchor=top-right
layer=top
icons=1
max-icon-size=40
markup=1
actions=1
max-visible=5
format=<b>%s</b>\n%b

# Every notification disappears after 10 seconds (even if the app asks for another timeout)
default-timeout=10000
ignore-timeout=1

[urgency=low]
border-color=#444b6a

[urgency=critical]
border-color=#f7768e
