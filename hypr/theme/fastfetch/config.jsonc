// ~/.config/fastfetch/config.jsonc - Tokyo Night colors, same look as the bar. Linked by install.sh.
// Colors are truecolor codes:  cyan 13;185;215  blue 122;162;247  purple 173;142;230  grey 68;75;106
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "38;2;13;185;215", "2": "38;2;122;162;247", "3": "38;2;173;142;230" }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;13;185;215",
      "title": "38;2;173;142;230",
      "separator": "38;2;68;75;106",
      "output": "38;2;169;177;214"
    },
    "key": { "width": 11 },
    "percent": { "type": 3 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "\uf303  OS" },
    { "type": "host",     "key": "\uf108  Host" },
    { "type": "kernel",   "key": "\uf17c  Kernel" },
    { "type": "uptime",   "key": "\uf017  Uptime" },
    { "type": "packages", "key": "\uf187  Packages" },
    { "type": "shell",    "key": "\uf120  Shell" },
    { "type": "de",       "key": "\uf108  Desktop" },
    { "type": "wm",       "key": "\uf2d0  WM" },
    { "type": "terminal", "key": "\uf120  Terminal" },
    { "type": "cpu",      "key": "\uf2db  CPU" },
    { "type": "gpu",      "key": "\uf26c  GPU" },
    { "type": "memory",   "key": "\uf1c0  Memory" },
    { "type": "disk",     "key": "\uf0a0  Disk", "folders": "/" },
    { "type": "battery",  "key": "\uf240  Battery" },
    { "type": "locale",   "key": "\uf0ac  Locale" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
